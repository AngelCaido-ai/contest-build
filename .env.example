# === Domain (used by Caddy for auto HTTPS) ===
DOMAIN=api.example.com

# === PostgreSQL ===
POSTGRES_DB=contest
POSTGRES_USER=contest
POSTGRES_PASSWORD=change_me_strong_password

# === Telegram bots ===
BOT_TOKEN=123456:ABC-your-bot-token
WATCHER_BOT_TOKEN=789012:DEF-your-watcher-token
BOT_SECRET=random_shared_secret_between_api_and_bots

# === Security ===
JWT_SECRET=random_jwt_secret_at_least_32_chars
ESCROW_SECRET_KEY=64_hex_chars_from_secrets_token_hex_32

# === TON escrow ===
TON_NETWORK=testnet
TON_API_KEY=your_toncenter_api_key
TON_HOT_WALLET=EQ...your_hot_wallet_address
TON_API_URL=https://testnet.toncenter.com/api/v2

# === Telethon MTProto stats (optional) ===
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=

# === Optional ===
BOT_LOG_CHAT_ID=
CORS_ORIGINS=https://your-miniapp-domain.com
PAYMENT_TIMEOUT_MINUTES=1440
VERIFICATION_WINDOW_MINUTES=60
